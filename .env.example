# Copy this file to .env (`make init` does it for you) and fill in the blanks.
# .env is git-ignored. Never commit it, and never paste it anywhere public.
# Keep comments on their own lines: Docker reads this file literally.

# --- OpenAQ -----------------------------------------------------------------
# Free key from https://explore.openaq.org/register
OPENAQ_API_KEY=

# Optional tuning. The defaults cover Washington State.
# Bounding box as minLon,minLat,maxLon,maxLat
# OPENAQ_BBOX=-124.85,45.54,-116.91,49.01
# OPENAQ_ISO=US
# OPENAQ_PARAMETERS=pm25,pm10,o3,no2,so2,co
# Only government reference monitors (fewer sensors, faster runs)
# OPENAQ_MONITORS_ONLY=false
# Hard cap on sensors per run, as a safety valve for the API rate limit
# OPENAQ_MAX_SENSORS=

# --- AWS (the extractor writes raw files to S3) -----------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
S3_BUCKET=
S3_PREFIX=raw/openaq

# To try the extractor before you have an AWS account, write to a local
# folder instead of S3:
# RAW_LOCAL_DIR=/tmp/openaq_raw

# --- Snowflake --------------------------------------------------------------
# Account identifier in the form orgname-accountname (Snowsight: account menu at
# the bottom left > "View account details"). A dash, not a dot.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=ELT_SERVICE
# Path used when you run commands directly on your machine. Inside Docker the
# compose file points this at the mounted secrets folder for you.
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/snowflake_rsa_key.p8
SNOWFLAKE_ROLE=ELT_ROLE
SNOWFLAKE_WAREHOUSE=ELT_WH
SNOWFLAKE_DATABASE=AIR_QUALITY

# --- dbt --------------------------------------------------------------------
# Used when you run dbt by hand. Airflow always runs the prod target.
DBT_TARGET=dev

# --- Airflow ----------------------------------------------------------------
# On Linux set this to the output of `id -u` so containers can read your files
# (`make init` does it). On macOS and Windows leave it as is.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# How many full UTC days each daily run re-pulls (covers late-arriving data).
PIPELINE_LOOKBACK_DAYS=2

# Optional: a Slack incoming-webhook URL for failure alerts.
# For Discord, use the webhook URL with /slack added to the end.
ALERT_WEBHOOK_URL=
